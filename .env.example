# Bun Backend Server
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
SQLITE_DB_PATH=./data/odystorm.db

# App Public Origin & Better Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
BETTER_AUTH_SECRET=odystorm-dev-secret-change-in-production-32chars
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails automatically granted the 'admin' role on sign-up/seed
ADMIN_EMAILS=admin@odystorm.xyz

# Optional Social OAuth Providers (auto-enabled when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional VAPID Keys for Browser Web Push (auto-generated on first boot if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@odystorm.xyz
